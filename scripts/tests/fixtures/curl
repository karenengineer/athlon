#!/usr/bin/env bash
set -euo pipefail
printf 'curl %s\n' "$*" >> "$TEST_FIXTURE/events"
if [[ "${1:-}" != --disable ]]; then
  printf 'curl-missing-leading-disable\n' >> "$TEST_FIXTURE/events"
fi
url="${!#}"
path_and_query="/${url#*://*/}"
redirect_response() {
  local failure="$1"
  if [[ "${TEST_FAIL:-}" == "$failure" ]]; then
    printf 'HTTP/2 200\r\n\r\n'
  else
    printf 'HTTP/2 308\r\nLocation: https://athlon.am%s\r\n\r\n' "$path_and_query"
  fi
}
case "$url" in
  *health/live) [[ "${TEST_FAIL:-}" != health ]] && printf '{"status":"ok"}\n' || printf '{"status":"broken"}\n' ;;
  *products\?*) [[ "${TEST_FAIL:-}" != products ]] && printf '{"items":[],"meta":{"total":0,"page":1,"pageSize":1,"totalPages":0}}\n' || printf '{"error":"broken"}\n' ;;
  http://www.athlon.am/*) redirect_response www-new-http ;;
  https://www.athlon.am/*) redirect_response www-new-https ;;
  http://athlonsport.am/*) redirect_response legacy-apex-http ;;
  https://athlonsport.am/*) redirect_response legacy-apex-https ;;
  http://www.athlonsport.am/*) redirect_response legacy-www-http ;;
  https://www.athlonsport.am/*) redirect_response legacy-www-https ;;
  https://athlon.am/*)
    if [[ "$*" == *'--dump-header'* ]]; then
      [[ "${TEST_FAIL:-}" != hsts ]] && printf 'HTTP/2 200\r\nstrict-transport-security: max-age=31536000; includeSubDomains\r\n\r\n' || printf 'HTTP/2 200\r\n\r\n'
    elif [[ "$url" == */hy || "$url" == */ru || "$url" == */en ]]; then
      [[ "${TEST_FAIL:-}" != page ]] || exit 22
    fi
    ;;
  *) exit 22 ;;
esac
