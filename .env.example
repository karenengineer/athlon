# Application settings only. SSH deployment credentials and Telegram token/chat ID
# belong exclusively in GitHub's production environment secrets, never this file.
NODE_ENV=development
PORT=3000
POSTGRES_DB=athlon
POSTGRES_USER=athlon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://athlon:change-me@localhost:5432/athlon?schema=public
CORS_ORIGINS=http://localhost:4200
# Set to the exact trusted proxy hop count only when running behind a proxy.
TRUST_PROXY_HOPS=0
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_COOKIE_NAME=athlon_csrf
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@athlonsport.am
# Online card payment remains disabled until Ameria activates ATHLON's merchant
# account and supplies its official integration manual and sandbox credentials.
AMERIA_PAYMENTS_ENABLED=false
AMERIA_API_BASE_URL=
AMERIA_CHECKOUT_BASE_URL=
AMERIA_MERCHANT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
# Isolated admin-only mock checkout; keep disabled unless deliberately testing.
CARD_PAYMENT_TEST_FLOW_ENABLED=false
# Admin test flow backend: MOCK (default) or AMERIA_SANDBOX (Ameriabank test vPOS).
# AMERIA_SANDBOX needs the test credentials below and the public site origin for
# the bank's return URL. Test OrderIDs are 30543001-30544000 and the amount is 10 AMD.
CARD_PAYMENT_TEST_MODE=MOCK
AMERIA_TEST_API_BASE_URL=https://servicestest.ameriabank.am/VPOS
AMERIA_TEST_CLIENT_ID=
AMERIA_TEST_USERNAME=
AMERIA_TEST_PASSWORD=
AMERIA_TEST_BACK_URL_BASE=
