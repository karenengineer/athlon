# Application settings only. SSH deployment credentials and Telegram token/chat ID
# belong exclusively in GitHub's production environment secrets, never this file.
NODE_ENV=development
PORT=3000
POSTGRES_DB=athlon
POSTGRES_USER=athlon
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://athlon:change-me@localhost:5432/athlon?schema=public
CORS_ORIGINS=http://localhost:4200
# Set to the exact trusted proxy hop count only when running behind a proxy.
TRUST_PROXY_HOPS=0
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-another-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_COOKIE_NAME=athlon_csrf
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESEND_API_KEY=
ORDER_FROM_EMAIL=orders@athlonsport.am
# Online card payment remains disabled until Ameria activates ATHLON's merchant
# account and supplies its official integration manual and sandbox credentials.
AMERIA_PAYMENTS_ENABLED=false
AMERIA_API_BASE_URL=
AMERIA_CHECKOUT_BASE_URL=
AMERIA_MERCHANT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
# Isolated guest checkout test route. Keep disabled until a deliberate test window.
CARD_PAYMENT_TEST_FLOW_ENABLED=false
# Allowed modes: MOCK or AMERIA_SANDBOX. Ordinary card payments stay disabled above.
CARD_PAYMENT_TEST_MODE=MOCK
# Provision sandbox credentials privately; never use live merchant credentials here.
AMERIA_SANDBOX_CLIENT_ID=1c9471a9-e010-4ad6-a1e6-0fc38b2577e2
AMERIA_SANDBOX_USERNAME=3d19541048
AMERIA_SANDBOX_PASSWORD=lazY2k
# Separate high-entropy test-page access code, at least 32 characters; never a bank password.
CARD_PAYMENT_TEST_ACCESS_TOKEN=
# Exact sandbox return origin; alternate origins fail closed.
AMERIA_SANDBOX_RETURN_ORIGIN=https://athlon.am
