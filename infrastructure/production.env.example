NODE_ENV=production
SITE_DOMAIN=athlon.am
POSTGRES_DB=athlon
POSTGRES_USER=athlon
POSTGRES_PASSWORD=replace-with-random-value
DATABASE_URL=postgresql://athlon:replace-with-random-value@postgres:5432/athlon?schema=public
CORS_ORIGINS=https://athlon.am
# Production requests reach the API through exactly one Caddy proxy.
TRUST_PROXY_HOPS=1
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-at-least-32-other-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CSRF_COOKIE_NAME=athlon_csrf
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_BYTES=5242880
ADMIN_EMAIL=
ADMIN_PASSWORD=
RESEND_API_KEY=replace-with-private-resend-api-key
ORDER_FROM_EMAIL=orders@athlonsport.am
# Keep disabled until merchant onboarding and sandbox verification are complete.
AMERIA_PAYMENTS_ENABLED=false
AMERIA_API_BASE_URL=
AMERIA_CHECKOUT_BASE_URL=
AMERIA_MERCHANT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
# Isolated guest checkout test route. Keep disabled until a deliberate test window.
CARD_PAYMENT_TEST_FLOW_ENABLED=false
# Allowed modes: MOCK or AMERIA_SANDBOX. Ordinary card payments stay disabled above.
CARD_PAYMENT_TEST_MODE=MOCK
# Provision sandbox credentials privately; never use live merchant credentials here.
AMERIA_SANDBOX_CLIENT_ID=
AMERIA_SANDBOX_USERNAME=
AMERIA_SANDBOX_PASSWORD=
# Separate high-entropy test-page access code, at least 32 characters; never a bank password.
CARD_PAYMENT_TEST_ACCESS_TOKEN=
# Exact sandbox return origin; alternate origins fail closed.
AMERIA_SANDBOX_RETURN_ORIGIN=https://athlon.am
SWAGGER_ENABLED=false
SSR_API_BASE_URL=http://api:3000/api/v1
