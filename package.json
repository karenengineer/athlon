{
  "name": "athlon-sport",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @athlon/api build && pnpm --filter @athlon/web build",
    "build:api": "pnpm --filter @athlon/api build",
    "build:web": "pnpm --filter @athlon/web build",
    "dev": "pnpm --parallel --filter @athlon/api --filter @athlon/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm --filter @athlon/api lint && pnpm --filter @athlon/web lint",
    "postinstall": "pnpm prisma:generate",
    "prisma:generate": "pnpm --filter @athlon/api prisma:generate",
    "prisma:validate": "pnpm --filter @athlon/api prisma:validate",
    "test": "pnpm --filter @athlon/api test && pnpm --filter @athlon/web test",
    "test:e2e": "pnpm --filter @athlon/api test:e2e",
    "typecheck": "pnpm --filter @athlon/api exec tsc -p tsconfig.json --noEmit && pnpm --filter @athlon/web exec tsc -p tsconfig.app.json --noEmit",
    "test:ssr": "node scripts/test-production-ssr.mjs",
    "verify": "pnpm format:check && pnpm prisma:validate && pnpm prisma:generate && pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm build && pnpm test:ssr"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
